# Intensidad Poisson
lambda <- exp(eta)
# Variable respuesta (conteo)
numero_talas <- rpois(n, lambda)
# Base de datos
datos_tala_ilegal_poisson <- data.frame(
numero_talas,
densidad_poblacion,
superficie_forestal_ha,
dias_vigilancia
)
# Guardar base
ruta <- "C:/Users/dbaza/Documents/Bases_datos/tala_ilegal_poisson.csv"
write.csv(datos_tala_ilegal_poisson, ruta, row.names = FALSE)
# Resumen
summary(datos_tala_ilegal_poisson)
# ---------------------------------------------------
# SERIE TEMPORAL – AR, MA y ARMA
# Anomalía de temperatura
# ---------------------------------------------------
set.seed(789)
n <- 240  # 20 años mensuales (ideal para ACF/PACF)
# Generar serie ARMA(2,1)
anomalia_c <- arima.sim(
model = list(
ar = c(0.6, -0.3),
ma = c(0.5)
),
n = n,
sd = 0.4
)
# Crear objeto ts
datos_anomalia_temperatura <- data.frame(
tiempo = 1:n,
anomalia_c = as.numeric(anomalia_c)
)
# Guardar base
ruta <- "C:/Users/dbaza/Documents/Bases_datos/anomalia_temperatura_ts.csv"
write.csv(datos_anomalia_temperatura, ruta, row.names = FALSE)
# Convertir a serie temporal
ts_anomalia <- ts(datos_anomalia_temperatura$anomalia_c,
start = c(2005, 1),
frequency = 12)
# ---------------------------------------------------
# BASE DE DATOS – AR / MA / ARMA
# Anomalía de temperatura
# ---------------------------------------------------
set.seed(789)
n <- 240  # 20 años de datos mensuales
# Fechas (mensuales)
fecha <- seq(
from = as.Date("2005-01-01"),
by   = "month",
length.out = n
)
# Proceso ARMA(1,1) poblacional
# (permite ajustar AR, MA y ARMA)
anomalia_c <- arima.sim(
model = list(ar = 0.6, ma = 0.4),
n = n,
sd = 0.25
)
# Base de datos
datos_anomalia_temperatura <- data.frame(
fecha,
anomalia_c
)
# Guardar base
ruta <- "C:/Users/dbaza/Documents/Bases_datos/datos_anomalia_temperatura.csv"
write.csv(datos_anomalia_temperatura, ruta, row.names = FALSE)
# Vista rápida
head(datos_anomalia_temperatura)
summary(datos_anomalia_temperatura)
# ---------------------------------------------------
# BASE DE DATOS – ARIMA
# Nivel de presa
# ---------------------------------------------------
set.seed(1010)
n <- 300  # ~25 años de datos mensuales
# Fechas mensuales
fecha <- seq(
from = as.Date("2000-01-01"),
by = "month",
length.out = n
)
# Componente de tendencia
tendencia <- seq(0, 12, length.out = n)
# Componente AR(1) sobre las diferencias
ruido <- arima.sim(
model = list(ar = 0.7),
n = n,
sd = 0.4
)
# Serie final (nivel de presa)
nivel_mnivel_m <- 45 + tendencia + ruido
# Base de datos
datos_nivel_presa <- data.frame(
fecha,
nivel_mnivel_m
)
# Guardar base
ruta <- "C:/Users/dbaza/Documents/Bases_datos/nivel_presa_arima.csv"
write.csv(datos_nivel_presa, ruta, row.names = FALSE)
# Vista inicial
head(datos_nivel_presa)
summary(datos_nivel_presa)
