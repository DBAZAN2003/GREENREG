# . -----------------------------------------------------------------------
#            Comprobacion de colinealidad/Multicolinealidad
# . -----------------------------------------------------------------------

# Antes de verificar la colinealidad entre las variables exploratorias, 
# elimine la variable respuesta (E100 y SR ) y la profundidad no 
# transformada (DP). Lo anterior se hace con el propósito de que unicamente,
# queden variables explicativas en las base de datos, ya que a las variables
# explicativas son a las que se les mide la multicolinealiad.

# NOTA: E100 y SR son la variabe respuesta, pero la primera está
# enrarecida a 100 individuos  y la segunda es el  numero de especies
# tomado en campo

data_check <- data_oc2[, !names(data_oc2) %in% c("E100", "DP", "SR")]
tail(data_check,3)

# Correlación de pearson
library("corrplot") # corrplot::corrplot()
library("psych") # psych::corr.test
library("car") # car::scatterplotMatrix
r<-cor(data_check, use = "complete.obs")
r
corrplot(r,method="ellipse",type="lower",order="hclust",
         number.cex = .9,addCoef.col = "black")
# COnclusión: Alta correlacion entre SP e IC, IC y P, SP y P, IC y BT


# . -----------------------------------------------------------------------
#               Seleccion de variables 
# . -----------------------------------------------------------------------

# Nota: Para la selección de variables, debe tomar en consideración la
# correlación de pearson.

# 1. Selección automática de variables considerando un valor umbral de 
#    correlación

# https://github.com/luismurao/ntbox
#if (!require('devtools')) install.packages('devtools')
#devtools::install_github('luismurao/ntbox')
# If you want to build vignette, install pandoc before and then
#devtools::install_github('luismurao/ntbox',build_vignettes=TRUE)
#install.packages(ntbox,dependencies = T)
#run_ntbox()

library(rlang)
var_cor <- r
var_sel <- ntbox::correlation_finder(cor_mat = var_cor,
                                       threshold = 0.6,
                                       verbose = FALSE)
var_sel$descriptors #variables seleccionadas

# Conclusión: Realizar la correlación le permite saber que variables 
# podria eliminar del modelo a traves del VIF

# 2. Slección de variables vía el VIF (Valor de Inflación de Varianza)

#  Si el VIF de una variable es superior a 5 se considera que esa 
# variable aumenta la varianza del modelo.

# Modelo nulo (No contempla variables explicativas, el valor 1 indica
# que el modelo solo se estimara con el intercepto)
mod_nulo <- lm(data_oc2$E100 ~ 1, data = data_check)
summary.lm(mod_nulo)
summary.lm(mod_nulo)$r.squared
AIC(mod_nulo)
anova(mod_nulo)

# Modelo con covariables (Contempla todas variables explicativas, el 
#  . indica que el modelo estimara el intercepto y los demás betas)
mod_vif <- lm(data_oc2$E100 ~ ., data = data_check)
summary.lm(mod_vif)
summary.lm(mod_vif)$r.squared
AIC(mod_vif)
anova(mod_vif)
library(car)
vif(mod_vif)

# Conclusión: Las variables: SP e IC aumentan la varianza del modelo.
# IC se correlaciona con muchas variables, incluida la Productividad (SP).
# En este caso se asumirá que la productividad es mas importante que IC, 
# por lo tanto elimine IC

data_env <- data_check[, names(data_check) != "IC"]
tail(data_env,3)

# Se ajusta el modelo nuevamente, pero se incluye la interacción entre
# temperatura y DPlog, en aras de demostracion, independientemente de 
# si dicha interacción tiene sentido

mod_vif_1 <- lm(data_oc2$E100 ~ . + BT:DPlog, data = data_env,
            na.action = "na.fail")
summary.lm(mod_vif_1)
summary.lm(mod_vif_1)$r.squared
AIC(mod_vif_1)
anova(mod_vif_1)
vif(mod_vif_1)
# Conclusion: BT, BT:DPLog y SA tiene un VIF > 5; por lo tanto,
# se elimina BT, que tiene el mayor valor del VIF# 

data_env1 <- data_env[, names(data_env ) != "BT"]
tail(data_env1,3)

mod_vif_2 <- lm(data_oc2$E100 ~ ., data = data_env1,
            na.action = "na.fail")
summary.lm(mod_vif_2)
summary.lm(mod_vif_2)$r.squared
AIC(mod_vif_2)
anova(mod_vif_2)
vif(mod_vif_2)

# Conclusion: SA y Sp no son estadisticamente significativas al 0.05;
# Por lo tanto, se eliminara SP que es la que se correlaciona con mayor
# grado.
data_env2 <- data_env1[, names(data_env1 ) != "SP"]
tail(data_env2,3)

mod_vif_3 <- lm(data_oc2$E100 ~ ., data = data_env2,
             na.action = "na.fail")
summary.lm(mod_vif_3)
summary.lm(mod_vif_3)$r.squared
AIC(mod_vif_3)
anova(mod_vif_3)
vif(mod_vif_3)

# Se elimina a RC dado que no es estadisticamente significativa
data_env3 <- data_env2[, names(data_env2 ) != "RC"]
tail(data_env3,3)

mod_vif_4 <- lm(data_oc2$E100 ~ ., data = data_env3,
             na.action = "na.fail")
summary.lm(mod_vif_4)
summary.lm(mod_vif_4)$r.squared
AIC(mod_vif_4)
anova(mod_vif_4)
vif(mod_vif_4)

# Se elimina a LAT dado que en conjunto no es estadisticamente 
# significativa
data_env4 <- data_env3[, names(data_env3 ) != "LAT"]
tail(data_env4,3)

mod_vif_5 <- lm(data_oc2$E100 ~ ., data = data_env4,
             na.action = "na.fail")
summary.lm(mod_vif_5)
summary.lm(mod_vif_5)$r.squared
AIC(mod_vif_5)
anova(mod_vif_5)
vif(mod_vif_5)

# NOTA: Es importante recorda que la eliminacion de variables
# está sujeta al conocimiento del investigador, pero también al
# bondad de ajuste del modelo, es decir al r2; razon por la cual 
# se elige el modelo mod_vif_4, que tiene todos sus estimadores 
# estadísticamente significativos y que su r^2 es el más elevado.

mod_final<-mod_vif_4 <- lm(data_oc2$E100 ~ ., data = data_env3,
             na.action = "na.fail")
mod_final
summary.lm(mod_final)$r.squared
vif(mod_final)
AIC(mod_final)

# Conlusión: Este modelo fue elegido de acuerdo al conocimiento del 
# problema a resolver y en cosnecuecnia de acuerdo al criterio del 
# investigador

# -------------------------------------------------------------------------
#         Evaluación del modelo por separado (bo,b1...,bk) 
# -------------------------------------------------------------------------

# 1. Prueba de hipotesis
summary.lm(mod_final)

# 2. Intervalo de confianza para los parámetros
confint(mod_final)

# -------------------------------------------------------------------------
#                Evaluación del modelo en su conjunto 
# -------------------------------------------------------------------------
anov <- anova(mod_final)
sctotal <-sum(as.vector(anov$`Sum Sq`))
scerror <- as.data.frame(anov$`Sum Sq`)[6,]
scregr <- sctotal-scerror

# 1. Evaluación del modelo en su conjunto

summary.lm(mod_final) #p.value

# 2. Variabilidad explicada por el modelo

varexpl <- round((scregr/sctotal)*100,2)
varexpl

# 3. Vaiabilidad no explicada por el modelo

varnoexpl <- round((scerror/sctotal)*100,2)
varnoexpl

# -------------------------------------------------------------------------
#    Predicción de un nuevo dato con las variables seleccionadas
# -------------------------------------------------------------------------

newdata = data.frame(SA= 32.1854,P= 223.8269,LAT =59.08,
                       LON=  -138.67, DPlog= 1.886491)
predict(mod_final, newdata)

# -------------------------------------------------------------------------
#      Intervalo de confianza y de predicción
# -------------------------------------------------------------------------

predict(mod_final, newdata, interval="confidence") 

predict(mod_final, newdata, interval="predict")


# -----------------------------------------------------------------------
