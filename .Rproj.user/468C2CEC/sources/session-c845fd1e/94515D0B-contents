library(lmtest)
dwtest(mod_final,alternative="two.sided") 

# 4. Aditividad

residualPlots(mod_final,plot=F)
# Ho: El modelo es aditivo
# H1: el modelo no es aditivo

# 5. Linealidad: 
# "Gráficos de Componentes más Residuales (Parciales)". Dan una visión 
# más clara y precisa de cómo una variable afecta a otra en un modelo 
# de regresión, controlando por el efecto de otras variables. Esto es 
# crucial para comprender las relaciones entre las variables en 
# presencia de múltiples factores que podrían influir en la relación 
# que estás investigando.

library(car)
crPlots(mod_final)
#  Si la linea azul no se ajusta a la curva dada por una regresión no 
# paramétrica suave color rosa, el modelo no es lineal.

# 6. Observaciones anomalas

# a) Observacion con alto efecto palanca tienen una combinacion
#    inusual de valores predictores. Es decir, son aberrantes 
#    en el espacio predictor.
# b) Punto aberrante (outliers): es una observacion que no es 
#    predicha satisfactoriamente por el modelo de regresion 
#    (con un valor positivo o negativo grande del residuo)
# c) Observaciones influyentes: son aquellas con un impacto 
#    desproporcionado en la determinacion de los parametros 
#    del modelo. Se identifican usando la distancia de Cook, 
#    Cooks-D. Son de preocupar los puntos con Cooks-D>1

# a) Datos leverage
# Prueba Grafica. 
ols_plot_resid_lev(mod_final)

# Prueba analitica
k=5 # Variables explicativas
n<-length(data.frame(data_oc)[,1]) # Numero de observaciones

which(hatvalues(mod_final)>(2*(k+1)/n))

# b) Datos outliers

# Prueba  Grafica
ols_plot_resid_lev(mod_final)
# Prueba analitica

# H0: la observación i -ésima NO es un outlier 
# H1: la observación i -ésima SI es un outlier.
outlierTest(mod_final, cutoff=0.05, n.max=10, order=TRUE)

# c) Observaciones influyentes

# Prueba Grafica
ols_plot_cooksd_bar(mod_final)
ols_plot_cooksd_chart(mod_final)

# Prueba analitica
which(cooks.distance(mod_final)>4/(n-k-1))

