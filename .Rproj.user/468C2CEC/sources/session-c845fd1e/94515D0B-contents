ols_test_normality(mod_final)

# 2. Homocedasticidad de varianzas

# Prueba grafica
ols_plot_resid_fit(mod_final)
ols_plot_resid_stud(mod_final)
ols_plot_resid_stand(mod_final)
ols_plot_resid_stud_fit(mod_final)

# Prueba analitica
