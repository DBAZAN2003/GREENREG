###########################################################################
#              Métodos paso a paso (Stepwise Methods)
#    Selección de modelos de manera estadística y no con criterios del 
#                             investigador 
###########################################################################

# 1. Eliminación progresiva (Backwards Elimination ≡ BE)

# Se comienza con el conjunto completo de k variables explicativas. 
# En cada paso del algoritmo BE se elimina el regresor menos explicativo 
# individualmente. 

ols_step_backward_p(mod_vif)

data_envBW <- data_check[, !names(data_check ) %in% c("IC","LAT", "SA")]
head(data_envBW,3)

mod_BW <- lm(data_oc2$E100 ~ ., data = data_envBW,
              na.action = "na.fail")
summary.lm(mod_BW)
summary.lm(mod_BW)$r.squared
AIC(mod_BW)
anova(mod_BW)
vif(mod_BW)

# Nota: Este modelo eliminó las variables IC, LAT y SA. Sin embargo, 
# es importante verificar si las variables que quedaron explican el
# a la variable de respuesta.

# 2. Introducción progresiva (Forwards Selection ≡ FS)
# Se comienza con un subconjunto de 0 regresores. En cada iteración se añade 
# la variable Xj con el mayor ratio F (Izenman 2008).

ols_step_forward_p(mod_vif)

data_envFW <- data_check[, !names(data_check ) %in% c("IC","LON")]
tail(data_envFW,3)

mod_FW <- lm(data_oc2$E100 ~ ., data = data_envFW,
             na.action = "na.fail")
summary.lm(mod_FW)
summary.lm(mod_FW)$r.squared
anova(mod_FW)
AIC(mod_FW)
vif(mod_FW)

# Nota: Este modelo incluyo 7 variables, eliminó 2 variables IC y 
# LON. Es necesario verificar si las varbles elejidas explican
# la varaible de respuesta. No osbtante es imporatnte recordar que
# un modelo debe ser parsimonioso.


# 3. Regresión paso a paso (Stepwise Regression ≡ SR)
# Se trata de un procedimiento híbrido entre introducción y eliminación 
#  progresivas. Como en la introducción progresiva de predictores, se 
# comienza con 0 variables. En cada paso, al incluir una nueva variable 
# y estimar el nuevo modelo, se evalúa la pertinencia de eliminar 
# cualquiera de los regresores ya presentes 

ols_step_both_p(mod_vif)

data_envBO <- data_check[, !names(data_check ) %in% c("SA")]
tail(data_envBO,3)

mod_BO <- lm(data_oc2$E100 ~ ., data = data_envBO,
             na.action = "na.fail")
summary.lm(mod_BO)
summary.lm(mod_BO)$r.squared
AIC(mod_BO)
anova(mod_BO)
vif(mod_BO)

