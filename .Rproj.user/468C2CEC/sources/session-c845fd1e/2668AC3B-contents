#' Regresión de Poisson (Modelos de Conteo)
#'
#' Esta función ajusta un Modelo Lineal Generalizado (GLM) de la familia Poisson con
#' función de enlace logarítmica ($ln(\lambda)$). Está diseñada para modelar variables
#' de respuesta que representan conteos enteros no negativos (0, 1, 2, 3...) y tasas
#' de incidencia en estudios agronómicos, forestales y sociales.
#'
#' @details
#' El flujo interno de la función se divide en seis etapas críticas:
#' \enumerate{
#'   \item **Ajuste Log-Lineal:** Estima la relación entre los predictores y el logaritmo
#'         de la tasa de eventos ($\lambda$). Utiliza Máxima Verosimilitud (MLE) para el ajuste.
#'   \item **Interpretación de Tasas (IRR):** Los coeficientes originales ($\beta$) se
#'         exponencian automáticamente ($e^\beta$) para obtener los **Ratios de Tasas de Incidencia**.
#'         Esto permite concluir en qué porcentaje aumenta o disminuye la frecuencia de eventos
#'         por cada unidad de cambio en X.
#'   \item **Diagnóstico de Equidispersión:** Calcula el Ratio de Dispersión basado en el
#'         estadístico de Pearson ($X^2 / gl$). En una distribución Poisson perfecta, este
#'         valor debe ser 1. Valores > 1.5 indican **Sobredispersión**, sugiriendo que los
#'         datos varían más de lo que el modelo permite.
#'   \item **Inferencia Robusta:** Genera intervalos de confianza para los IRR, permitiendo
#'         identificar factores de riesgo (IRR > 1) y factores protectores (IRR < 1).
#'   \item **Evaluación de Residuos:** Calcula residuos de devianza y Pearson para identificar
#'         patrones de error sistemáticos o falta de ajuste en conteos específicos (como el cero).
#'   \item **Traducción Didáctica:** Genera un reporte que advierte si el modelo es válido
#'         o si se debe migrar a un modelo Binomial Negativa debido a la dispersión.
#' }
#'
#' @section Guía de las 8 Gráficas de Diagnóstico (`plot`):
#' Al ejecutar \code{plot(modelo)}, se despliega una secuencia de validación para conteos:
#' \describe{
#'   \item{\strong{1. Distribución de Conteos (Real vs Modelo)}}{Compara las frecuencias observadas contra las que el modelo "esperaba" predecir. Crucial para detectar el exceso de ceros.}
#'   \item{\strong{2. Precisión (Predicho vs Real)}}{Scatterplot entre el Lambda estimado y el conteo real. Los puntos deben seguir la tendencia de la línea roja diagonal.}
#'   \item{\strong{3. Importancia de Variables (IRR)}}{Visualiza el impacto relativo de cada predictor. Los puntos verdes son significativos; si el intervalo cruza el 1, la variable es ruido.}
#'   \item{\strong{4. Verificación de Sobredispersión}}{Grafica la relación Media-Varianza. Si la línea verde (datos) se eleva sobre la negra (teoría), el supuesto Poisson se rompe.}
#'   \item{\strong{5. Distancia de Cook}}{Identifica casos atípicos en el conteo que tienen un peso excesivo en la estimación de la tasa promedio.}
#'   \item{\strong{6. Residuos de Devianza}}{Analiza la calidad del ajuste en escala logarítmica. Busca una nube uniforme sin formas de "U" o de embudo.}
#'   \item{\strong{7. Apalancamiento (Leverage)}}{Detecta observaciones con valores de X inusuales que controlan la pendiente del modelo.}
#'   \item{\strong{8. Densidad de Ajuste Global}}{Superpone las curvas de probabilidad del modelo y la realidad para evaluar el solapamiento total.}
#' }
#'
#' @param formula Una fórmula de R (ej. \code{numero_frutos ~ riego + fertilizante}).
#' @param data Un \code{data.frame} con las observaciones (el conteo debe ser entero).
#'
#' @return Un objeto de clase \code{"poisson_chapireg"} que contiene:
#' \itemize{
#'   \item \code{modelo}: Objeto \code{glm} original de la familia Poisson.
#'   \item \code{irr_table}: Tabla con los Ratios de Tasas de Incidencia, intervalos y p-valores.
#'   \item \code{dispersion}: El ratio de dispersión calculado (Pearson / GL).
#'   \item \code{metricas}: Lista con AIC, Log-Verosimilitud y Devianzas.
#'   \item \code{predicciones}: Dataframe con valores observados, lambda estimado y diagnósticos (leverage/residuos).
#' }
#'
#' @examples
#'  # data("datos_tala_ilegal_poisson")
#'  # modelo_poisson <- reg_poisson(numero_talas ~ densidad_poblacion + superficie_forestal_ha + dias_vigilancia, data = datos_tala_ilegal_poisson)
#'  # modelo_poisson
#'  # plot(modelo_poisson)
#'
#' @importFrom stats glm poisson coef confint formula na.omit predict fitted residuals df.residual pnorm qnorm logLik pchisq cooks.distance hatvalues rstandard dpois quantile
#' @importFrom ggrepel geom_text_repel
#' @import ggplot2
#' @export
reg_poisson <- function(formula, data) {
  # --- 1. Ajuste del Modelo ---
  modelo_base <- stats::glm(formula, data = data, family = stats::poisson(link = "log"), na.action = stats::na.omit)

  # --- 2. Verificación de Equidispersión (Ratio de Pearson) ---
  # Si el ratio es > 1.5 o 2, hay sobredispersión
  pearson_chisq <- sum(stats::residuals(modelo_base, type = "pearson")^2)
  ratio_dispersion <- pearson_chisq / modelo_base$df.residual

  # --- 3. Coeficientes e IRR ---
  resumen <- summary(modelo_base)
  coefs_log <- stats::coef(modelo_base)
  irr <- exp(coefs_log)
  ci_irr <- exp(stats::confint(modelo_base))
  tabla_irr <- cbind(IRR = irr, `2.5 %` = ci_irr[,1], `97.5 %` = ci_irr[,2], `P-valor` = resumen$coefficients[,4])

  df_preds <- data.frame(
    obs = modelo_base$y,
    pred = stats::fitted(modelo_base),
    leverage = stats::hatvalues(modelo_base),
    resid_std = stats::rstandard(modelo_base)
  )
  # --- 4. Empaquetado ---
  resultado <- list(
    formula = formula,
    modelo = modelo_base,
    predicciones = df_preds,
    coeficientes = resumen$coefficients,
    irr_table = tabla_irr,
    dispersion = ratio_dispersion,
    metricas = list(
      aic = modelo_base$aic,
      loglik = as.numeric(stats::logLik(modelo_base)),
      null_dev = modelo_base$null.deviance,
      res_dev = modelo_base$deviance
    )
  )
  class(resultado) <- "poisson_chapireg"
  return(resultado)
}


#' Impresión Académica para Regresión de Poisson
#' @export
print.poisson_chapireg <- function(x, ...) {
  cat("\n==============================================================\n")
  cat("           REGRESIÓN POISSON (MODELO DE CONTEO) \n")
  cat("==============================================================\n\n")

  # --- 1. MODELO Y ECUACIÓN ---
  cat("--- 1. MODELO Y ECUACIÓN ---\n")
  cat("Fórmula:", deparse(x$formula), "\n")
  b <- round(coef(x$modelo), 3)
  vars <- names(b)
  ecuacion <- paste0("log(λ) = ", b[1])
  if(length(b) > 1) {
    for(i in 2:length(b)) ecuacion <- paste0(ecuacion, " + (", b[i], " * ", vars[i], ")")
  }
  cat("Ecuación estimada:\n", ecuacion, "\n\n")

  # --- 2. COEFICIENTES ESTIMADOS ---
  cat("--- 2. COEFICIENTES ESTIMADOS (IRR) ---\n")
  cat("Interpretación en Tasas de Incidencia (Incidence Rate Ratios):\n")
  print(round(x$irr_table, 4))
  cat("\n NOTA: Los IRR indican cuánto se multiplica la tasa de eventos.\n")
  cat("   - IRR > 1: Efecto multiplicativo (Riesgo).\n")
  cat("   - IRR < 1: Efecto de reducción (Protección).\n\n")

  # --- 3. EVALUACIÓN DEL MODELO ---
  cat("--- 3. EVALUACIÓN DEL MODELO (Ratio Test) ---\n")
  chi_cuad <- x$metricas$null_dev - x$metricas$res_dev
  df_chi <- x$modelo$df.null - x$modelo$df.residual
  p_val_lrt <- 1 - pchisq(chi_cuad, df_chi)
  cat(sprintf("• Chi-cuadrado Global: %.3f | GL: %d\n", chi_cuad, df_chi))
  cat("• P-valor (LRT):", format.pval(p_val_lrt), "\n")
  cat("• Conclusión:", if(p_val_lrt < 0.05) "El modelo explica significativamente los datos ✅" else "El modelo no es mejor que el promedio (nulo) ⚠️", "\n\n")

  # --- 4. BONDAD DE AJUSTE ---
  cat("--- 4. BONDAD DE AJUSTE ---\n")
  pseudo_r2 <- 1 - (x$metricas$res_dev / x$metricas$null_dev)
  cat(sprintf("• Log-Verosimilitud: %10.2f\n", x$metricas$loglik))
  cat(sprintf("• Devianza Residual: %10.2f\n", x$metricas$res_dev))
  cat(sprintf("• Pseudo R² (McFadden): %7.2f%%\n", pseudo_r2 * 100))
  cat("  (Representa la reducción de la incertidumbre/error respecto al modelo nulo).\n\n")

  # --- 5. SIGNIFICANCIA DE COEFICIENTES ---
  cat("--- 5. SIGNIFICANCIA DE COEFICIENTES (Prueba Wald) ---\n")
  stats::printCoefmat(x$coeficientes, digits = 4, signif.stars = TRUE)
  cat("\n")

  # --- 6. VERIFICACIÓN DE SUPUESTOS ---
  cat("--- 6. VERIFICACIÓN DE SUPUESTOS ---\n")
  # A) Equidispersión
  cat(sprintf("• Equidispersión (Ratio): %.2f\n", x$dispersion))
  if(x$dispersion > 1.5) {
    cat("  ⚠️ ALERTA: Hay SOBREDISPERSIÓN (Ratio > 1.5). Los p-valores podrían estar subestimados.\n")
  } else {
    cat("  ✅ OK: Se cumple razonablemente el supuesto de equidispersión (Media ≈ Varianza).\n")
  }
  # B) Otros supuestos
  cat("• Independencia: Asumida por el diseño de muestreo.\n")
  cat("• Linealidad: Se asume que log(Media) es lineal respecto a las variables X.\n\n")

  # --- 7. RESUMEN DEL MODELO ---
  cat("--- 7. RESUMEN DEL MODELO ---\n")
  sig_vars <- rownames(x$irr_table)[x$irr_table[, "P-valor"] < 0.05]
  if(length(sig_vars) > 0) {
    cat("Variables significativas identificadas:", paste(sig_vars, collapse = ", "), "\n")
  } else {
    cat("No se encontraron variables con impacto estadístico significativo.\n")
  }

  if(x$dispersion > 2) {
    cat("\n❗ RECOMENDACIÓN : Debido a la alta sobredispersión, se sugiere \nprobar un modelo Binomial Negativa o usar errores estándar robustos.\n")
  }

  cat("\n==============================================================\n")
}

#' Generación de Gráficas
#' @export
plot.poisson_chapireg <- function(x, ...) {
  # Verificar dependencias
  if (!requireNamespace("ggplot2", quietly = TRUE)) stop("Necesitas instalar 'ggplot2'.")

  # --- 1. Extracción y Validación de Datos ---
  modelo <- x$modelo
  if (is.null(x$predicciones)) stop("❌ Error interno: No se encontraron predicciones.")
  df_preds <- x$predicciones

  # Tema visual consistente
  mi_tema <- ggplot2::theme_minimal() +
    ggplot2::theme(
      plot.title = ggplot2::element_text(face = "bold", size = 14, color = "#2C3E50"),
      plot.subtitle = ggplot2::element_text(size = 11, color = "#7F8C8D"),
      plot.caption = ggplot2::element_text(hjust = 0, size = 10, face = "italic", color = "#555555", margin = ggplot2::margin(t = 10))
    )

  cat("Generando 5 gráficas de diagnóstico... (Presiona [Enter] para avanzar)\n")


  # --- GRÁFICA 1: CONTEOS OBSERVADOS VS PREDICHOS ---

  # Determinamos el límite del eje X (evitando valores extremos que arruinen la visualización)
  max_val_obs <- max(df_preds$obs, na.rm = TRUE)
  max_count <- round(stats::quantile(df_preds$obs, 0.99, na.rm = TRUE))
  if (is.na(max_count) || max_count < 1) max_count <- max_val_obs

  # A) Frecuencia Real (Observada)
  obs_limpios <- df_preds$obs[!is.na(df_preds$obs)]
  freq_real <- table(factor(obs_limpios, levels = 0:max_count))
  df_counts <- data.frame(Conteo = 0:max_count, Freq = as.numeric(freq_real), Tipo = "Realidad")

  # B) Frecuencia Esperada (Modelo Poisson)
  # Calculamos la probabilidad de cada conteo k dado el lambda (pred) de cada fila
  probs_matrix <- sapply(0:max_count, function(k) {
    sum(stats::dpois(k, lambda = df_preds$pred), na.rm = TRUE)
  })

  df_expected <- data.frame(Conteo = 0:max_count, Freq = probs_matrix, Tipo = "Modelo (Esperado)")

  # Combinamos ambos para ggplot
  df_comparacion <- rbind(df_counts, df_expected)

  g1 <- ggplot2::ggplot(df_comparacion, ggplot2::aes(x = factor(Conteo), y = Freq, fill = Tipo)) +
    ggplot2::geom_bar(stat = "identity", position = "dodge", alpha = 0.8) +
    ggplot2::scale_fill_manual(values = c("Realidad" = "#34495E", "Modelo (Esperado)" = "#E67E22")) +
    ggplot2::labs(
      title = "1. Distribución de Conteos (Real vs Modelo)",
      subtitle = "¿Predice el modelo la cantidad correcta de eventos?",
      x = "Número de Eventos (Conteo)",
      y = "Frecuencia Total",
      caption = paste0("INTERPRETACIÓN:\n",
                       "✅ BIEN: Las barras naranjas (Modelo) tienen casi la misma altura que las grises (Realidad).\n",
                       "⚠️ ALERTA: Si la barra gris del '0' es gigante y la naranja pequeña, hay exceso de ceros.\n",
                       "⚠️ DISPERSIÓN: Si las barras reales son más anchas que las del modelo, hay sobredispersión.")
    ) +
    mi_tema

  print(g1)
  readline(prompt = "Gráfica 1/8 > ")


  # --- GRÁFICA 2: VALORES PREDICHOS VS VALORES REALES ---

  # Calculamos la correlación para mostrarla en el subtítulo
  cor_val <- stats::cor(df_preds$obs, df_preds$pred, method = "pearson")

  g2 <- ggplot2::ggplot(df_preds, ggplot2::aes(x = pred, y = obs)) +
    # Puntos con ligera transparencia para ver densidad (overplotting)
    ggplot2::geom_point(color = "#2E86C1", alpha = 0.5, size = 2) +
    # Línea de Identidad (Lo que sería un modelo perfecto)
    ggplot2::geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "red", size = 1) +
    # Suavizado logístico/tendencia para ver el comportamiento real
    ggplot2::geom_smooth(method = "glm", method.args = list(family = "poisson"),
                         color = "#F1C40F", se = TRUE, fill = "#F1C40F", alpha = 0.2) +
    ggplot2::labs(
      title = "2. Precisión del Modelo (Predicho vs Real)",
      subtitle = paste0("Correlación de Pearson: ", round(cor_val, 3)),
      x = "Valor Predicho (Lambda estimado)",
      y = "Valor Real (Conteo observado)",
      caption = paste0("INTERPRETACIÓN:\n",
                       "🔴 LÍNEA ROJA: Es la diagonal de perfección (donde Predicho = Real).\n",
                       "🟡 LÍNEA AMARILLA: Es la tendencia real de tus datos.\n",
                       "✅ BIEN: Si los puntos y la línea amarilla siguen de cerca a la roja.\n",
                       "⚠️ ALERTA: Si los puntos se alejan mucho hacia arriba conforme aumenta X, hay subestimación.")
    ) +
    mi_tema

  print(g2)
  readline(prompt = "Gráfica 2/8 > ")



  # --- GRÁFICA 3: IMPORTANCIA DE VARIABLES (IRR) ---

  # 1. Preparar los datos desde la tabla de IRR generada en la función principal
  df_irr <- as.data.frame(x$irr_table)
  df_irr$Variable <- rownames(df_irr)

  # 2. Limpieza: Excluimos el Intercepto para no distorsionar la escala visual
  df_irr <- df_irr[df_irr$Variable != "(Intercept)", ]

  # Renombrar columnas para facilitar el manejo en ggplot
  # Asumimos que la tabla tiene: IRR, 2.5 %, 97.5 %, P-valor
  colnames(df_irr) <- c("IRR", "Low", "High", "P_val", "Variable")

  # 3. Construcción de la Gráfica
  g3 <- ggplot2::ggplot(df_irr, ggplot2::aes(x = reorder(Variable, IRR), y = IRR)) +
    # Línea de referencia en 1 (indica que no hay efecto)
    ggplot2::geom_hline(yintercept = 1, linetype = "dashed", color = "black", size = 0.8) +
    # Barras de error (Intervalos de Confianza al 95%)
    ggplot2::geom_errorbar(ggplot2::aes(ymin = Low, ymax = High), width = 0.2, color = "#7F8C8D") +
    # Puntos del IRR colorizados por significancia
    ggplot2::geom_point(ggplot2::aes(color = P_val < 0.05), size = 4) +
    # Etiquetas con el valor del IRR sobre cada punto
    ggplot2::geom_text(ggplot2::aes(label = round(IRR, 2)), vjust = -1.2, size = 3.5, fontface = "bold") +
    # Invertimos ejes para que los nombres de variables sean legibles (horizontal)
    ggplot2::coord_flip() +
    # Colores semánticos: Verde para significativo, Rojo para no significativo
    ggplot2::scale_color_manual(values = c("TRUE" = "#27AE60", "FALSE" = "#E74C3C"),
                                labels = c("No Significativo", "Significativo (p < 0.05)")) +
    ggplot2::labs(
      title = "3. Importancia de Variables (IRR)",
      subtitle = "Impacto relativo en la tasa de eventos (Incidence Rate Ratio)",
      x = "Variables Predictoras",
      y = "IRR (Razón de Tasas de Incidencia)",
      color = "Estado del Coeficiente:",
      caption = paste0("INTERPRETACIÓN:\n",
                       "🟢 VERDE: La variable tiene un impacto real (p < 0.05).\n",
                       "⚫ LÍNEA EN 1: Si el intervalo cruza esta línea, la variable no influye.\n",
                       "👉 DERECHA (>1): La variable INCREMENTA la frecuencia de eventos.\n",
                       "👈 IZQUIERDA (<1): La variable REDUCE la frecuencia de eventos.")
    ) +
    mi_tema +
    ggplot2::theme(legend.position = "top")

  print(g3)
  readline(prompt = "Gráfica 3/8 > ")



  # --- GRÁFICA 4: VERIFICACIÓN DE SOBREDISPERSIÓN ---

  # Preparar datos: La varianza empírica se aproxima con el cuadrado de los residuos
  df_disp <- data.frame(
    predicho = df_preds$pred,
    res_sq = (df_preds$obs - df_preds$pred)^2
  )

  g4 <- ggplot2::ggplot(df_disp, ggplot2::aes(x = predicho, y = res_sq)) +
    # Puntos de dispersión
    ggplot2::geom_point(color = "#8E44AD", alpha = 0.4, size = 2) +
    # Línea de Equidispersión (Varianza = Media)
    ggplot2::geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "black", size = 1) +
    # Tendencia de la varianza real
    ggplot2::geom_smooth(method = "gam", color = "#2ECC71", fill = "#2ECC71", alpha = 0.2) +
    ggplot2::labs(
      title = "4. Verificación de Sobredispersión",
      subtitle = "¿Se cumple el supuesto de Media = Varianza?",
      x = "Media Predicha (λ)",
      y = "Varianza Observada (Residuos al cuadrado)",
      caption = paste0("INTERPRETACIÓN:\n",
                       "⚫ LÍNEA NEGRA: Representa la Equidispersión teórica (Poisson perfecta).\n",
                       "🟢 LÍNEA VERDE: Es la relación real entre media y varianza en tus datos.\n",
                       "✅ BIEN: Si la línea verde sigue de cerca a la negra punteada.\n",
                       "⚠️ ALERTA: Si la línea verde sube mucho más rápido que la negra, hay SOBREDISPERSIÓN.")
    ) +
    mi_tema

  print(g4)
  readline(prompt = "Gráfica 4/8 > ")

  # --- GRÁFICA 5: DATOS INFLUYENTES (DISTANCIA DE COOK) ---

  # 1. Cálculo de la Distancia de Cook
  cooks_d <- stats::cooks.distance(x$modelo)
  n_obs <- length(cooks_d)

  # Umbral crítico común: 4/n o 1 (usaremos 4/n por ser más sensible en muestras grandes)
  umbral_cook <- 4 / n_obs

  df_cook <- data.frame(
    ID = 1:n_obs,
    Distancia = cooks_d
  )

  # Etiquetamos solo los puntos que superan el umbral
  df_cook$Label <- ifelse(df_cook$Distancia > umbral_cook, as.character(df_cook$ID), "")

  g5 <- ggplot2::ggplot(df_cook, ggplot2::aes(x = ID, y = Distancia)) +
    # Líneas verticales (tipo 'h' de plot base) para cada observación
    ggplot2::geom_segment(ggplot2::aes(xend = ID, yend = 0), color = "darkgrey", alpha = 0.5) +
    # Puntos destacados
    ggplot2::geom_point(ggplot2::aes(color = Distancia > umbral_cook), size = 2) +
    # Línea de umbral crítico
    ggplot2::geom_hline(yintercept = umbral_cook, linetype = "dashed", color = "#E74C3C", size = 0.8) +
    # Etiquetas para los puntos influyentes
    ggrepel::geom_text_repel(ggplot2::aes(label = Label), size = 3.5, fontface = "bold") +
    # Colores: Rojo para los que superan el umbral
    ggplot2::scale_color_manual(values = c("FALSE" = "#3498DB", "TRUE" = "#E74C3C")) +
    ggplot2::labs(
      title = "5. Datos Influyentes (Distancia de Cook)",
      subtitle = paste0("Umbral crítico (4/n): ", round(umbral_cook, 4)),
      x = "Índice de la Observación (Fila)",
      y = "Distancia de Cook",
      caption = paste0("INTERPRETACIÓN:\n",
                       "🔴 PUNTOS ROJOS: Son observaciones que tienen un impacto excesivo en el modelo.\n",
                       "📏 UMBRAL: Si un punto está muy por encima de la línea roja, revisa sus datos.\n",
                       "⚠️ ACCIÓN: Podrían ser errores de dedo o casos excepcionales que distorsionan los IRR.")
    ) +
    mi_tema +
    ggplot2::theme(legend.position = "none")

  print(g5)
  readline(prompt = "Gráfica 5/8 > ")


  # --- GRÁFICA 6: ANÁLISIS DE RESIDUOS (DEVIANZA VS AJUSTADOS) ---

  # Extraemos residuos de devianza (los estándar para GLM Poisson)
  df_res <- data.frame(
    ajustados = log(df_preds$pred), # Usamos el log(lambda) para linearizar la escala
    residuos = stats::residuals(x$modelo, type = "deviance")
  )

  g6 <- ggplot2::ggplot(df_res, ggplot2::aes(x = ajustados, y = residuos)) +
    # Puntos de los residuos
    ggplot2::geom_point(color = "#16A085", alpha = 0.5, size = 2) +
    # Línea central en 0
    ggplot2::geom_hline(yintercept = 0, linetype = "dashed", color = "black", size = 0.8) +
    # Líneas de umbral (±2 son los límites esperados para la mayoría de los datos)
    ggplot2::geom_hline(yintercept = c(-2, 2), linetype = "dotted", color = "red", alpha = 0.5) +
    # Tendencia suavizada (Loess) para detectar patrones no lineales
    ggplot2::geom_smooth(method = "loess", color = "#E67E22", fill = "#E67E22", alpha = 0.2, formula = y ~ x) +
    ggplot2::labs(
      title = "6. Análisis de Residuos de Devianza",
      subtitle = "Residuos vs. Valores Ajustados (escala log)",
      x = "Valores Ajustados (Log-Lambda)",
      y = "Residuos de Devianza",
      caption = paste0("INTERPRETACIÓN:\n",
                       "✅ BIEN: Los puntos se reparten al azar arriba y abajo del cero (nube uniforme).\n",
                       "⚠️ CURVA: Si la línea naranja hace una 'U', te falta una variable cuadrática o interacción.\n",
                       "⚠️ EMBUDO: Si la dispersión aumenta hacia la derecha, confirma la Sobredispersión.\n",
                       " OUTLIERS: Puntos fuera de las líneas rojas (±2) están muy mal predichos.")
    ) +
    mi_tema

  print(g6)
  readline(prompt = "Gráfica 6/8 > ")

  # --- GRÁFICA 7: APALANCAMIENTO (LEVERAGE) ---

  # 1. Preparar datos de Leverage (h)
  # El leverage ya lo calculamos en la función principal y está en x$predicciones
  lev <- x$predicciones$leverage
  n_obs <- length(lev)
  p_vars <- length(stats::coef(x$modelo)) # Número de parámetros (k)

  # Umbral común: 2 * (k/n) o 3 * (k/n) para ser más conservadores
  umbral_lev <- (2 * p_vars) / n_obs

  df_lev <- data.frame(
    ID = 1:n_obs,
    Leverage = lev
  )

  # Etiquetar solo puntos con alto apalancamiento
  df_lev$Label <- ifelse(df_lev$Leverage > umbral_lev, as.character(df_lev$ID), "")

  g7 <- ggplot2::ggplot(df_lev, ggplot2::aes(x = ID, y = Leverage)) +
    # Líneas verticales para cada punto
    ggplot2::geom_segment(ggplot2::aes(xend = ID, yend = 0), color = "lightgrey", alpha = 0.6) +
    # Puntos con tamaño basado en su propio valor de leverage
    ggplot2::geom_point(ggplot2::aes(color = Leverage > umbral_lev, size = Leverage)) +
    # Línea de umbral crítico (2k/n)
    ggplot2::geom_hline(yintercept = umbral_lev, linetype = "dashed", color = "#2980B9", size = 0.8) +
    # Etiquetas de puntos atípicos en X
    ggrepel::geom_text_repel(ggplot2::aes(label = Label), size = 3.5, fontface = "bold") +
    # Escala de colores (Azul para normal, Naranja para alto leverage)
    ggplot2::scale_color_manual(values = c("FALSE" = "#BDC3C7", "TRUE" = "#E67E22")) +
    ggplot2::labs(
      title = "7. Análisis de Apalancamiento (Leverage)",
      subtitle = paste0("Umbral de diseño (2k/n): ", round(umbral_lev, 4)),
      x = "Índice de la Observación (Fila)",
      y = "Valor de Leverage (h)",
      caption = paste0("INTERPRETACIÓN:\n",
                       "🟠 PUNTOS NARANJA: Son observaciones con valores de X muy poco comunes.\n",
                       "📏 UMBRAL AZUL: Marca el límite donde un punto empieza a tener mucho peso.\n",
                       "NOTA: Un alto leverage no es malo por sí solo, pero si ese punto \n",
                       "   también tiene un residuo alto (Gráfica 6), está dañando tu modelo.")
    ) +
    mi_tema +
    ggplot2::theme(legend.position = "none")

  print(g7)
  readline(prompt = "Gráfica 7/8 > ")


  # --- GRÁFICA 8: AJUSTE DEL MODELO (DENSIDAD REAL VS PREDICHA) ---

  # Creamos un dataframe largo para facilitar el mapeo de colores en ggplot
  df_ajuste <- data.frame(
    Valor = c(df_preds$obs, df_preds$pred),
    Fuente = rep(c("Observado (Real)", "Ajustado (Modelo)"), each = nrow(df_preds))
  )

  g8 <- ggplot2::ggplot(df_ajuste, ggplot2::aes(x = Valor, fill = Fuente)) +
    # Usamos geom_density con alfa para ver la superposición
    ggplot2::geom_density(alpha = 0.4, color = "white") +
    # Añadimos líneas de media para cada grupo
    ggplot2::geom_vline(xintercept = mean(df_preds$obs), color = "#2C3E50", linetype = "dashed", size = 1) +
    ggplot2::geom_vline(xintercept = mean(df_preds$pred), color = "#D35400", linetype = "dashed", size = 1) +
    ggplot2::scale_fill_manual(values = c("Observado (Real)" = "#34495E", "Ajustado (Modelo)" = "#E67E22")) +
    ggplot2::labs(
      title = "8. Ajuste Global del Modelo",
      subtitle = "Comparación de Densidades: Realidad vs. Predicción",
      x = "Número de Eventos",
      y = "Densidad (Probabilidad suavizada)",
      caption = paste0("INTERPRETACIÓN:\n",
                       "✅ AJUSTE ÓPTIMO: Si ambas 'montañas' coinciden en posición y ancho.\n",
                       "⚠️ DESPLAZAMIENTO: Si las líneas punteadas (medias) están lejos, el modelo es sesgado.\n",
                       "⚠️ FORMA: Si la curva naranja es mucho más delgada que la gris, confirma la Sobredispersión.\n",
                       " NOTA: La línea naranja representa la 'esperanza' del modelo Poisson.")
    ) +
    mi_tema +
    ggplot2::theme(legend.position = "top")

  print(g8)

  cat("\nMostrando Gráfica 8: Análisis de superposición de densidades.\n")


  cat("✅ Diagnóstico Poisson completado.\n")
}
