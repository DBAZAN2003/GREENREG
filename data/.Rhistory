# 1. Define la ruta a la carpeta que contiene tus bases de datos
ruta_a_la_carpeta <- "C:/Users/dbaza/Documents/CHAPIREG/data/"
# 2. Lista todos los archivos que terminan en ".rda"
lista_de_archivos_rda <- list.files(path = ruta_a_la_carpeta,
pattern = "\\.rda$",
full.names = TRUE)
# 3. Imprime la lista de archivos encontrados
if (length(lista_de_archivos_rda) > 0) {
cat("Archivos .rda encontrados en la carpeta:\n")
print(lista_de_archivos_rda)
} else {
cat("No se encontró ningún archivo .rda en:\n", ruta_a_la_carpeta)
cat("Por favor, verifica la ruta y que los archivos tengan la extensión .rda")
}
# 1. Volvemos a generar la lista de archivos (por si acaso)
ruta_a_la_carpeta <- "C:/Users/dbaza/Documents/CHAPIREG/data/"
lista_de_archivos_rda <- list.files(path = ruta_a_la_carpeta,
pattern = "\\.rda$",
full.names = TRUE)
cat("Iniciando verificación de", length(lista_de_archivos_rda), "archivos .rda...\n")
# 2. Bucle para recorrer, cargar y mostrar el head()
for (archivo in lista_de_archivos_rda) {
# Imprime un separador para saber qué archivo estamos viendo
cat("\n----------------------------------------------------\n")
cat("Verificando archivo:", archivo, "\n")
cat("----------------------------------------------------\n\n")
# tryCatch es esencial aquí. Intenta ejecutar el código...
tryCatch({
# Creamos un "espacio" limpio y temporal
env_temporal <- new.env()
# Cargamos el archivo .rda DENTRO de ese espacio
# load() devuelve el nombre del objeto que cargó
nombres_objetos <- load(archivo, envir = env_temporal)
# Obtenemos el nombre del primer objeto que estaba en el archivo
nombre_obj <- nombres_objetos[1]
# Sacamos ese objeto del espacio temporal
datos <- get(nombre_obj, envir = env_temporal)
# --- ¡ÉXITO! ---
cat("Carga exitosa. Mostrando head() del objeto:", nombre_obj, "\n")
print(head(datos))
},
# ...y si hay un error (ej. archivo dañado), hace esto:
error = function(e) {
# --- ¡FALLO! ---
cat("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n")
cat("  ERROR: No se pudo cargar el archivo.\n")
cat("  El archivo puede estar dañado o tener un formato incorrecto.\n")
cat("  Mensaje de R:", e$message, "\n")
cat("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n")
}) # Fin de tryCatch
} # Fin del bucle for
cat("\n--- Verificación completada ---\n")
